# Build object files
*.o
*.obj

# Temporary / Editor files
*.tmp
*.log
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/

# Ignore binaries built inside src/
src/*.exe

# Allow precompiled binaries in x86/ and x86_64/ for ready-to-run releases
!x86/*.exe
!x86/*.dll
!x86/*.sys
!x86_64/*.exe
!x86_64/*.dll
!x86_64/*.sys
